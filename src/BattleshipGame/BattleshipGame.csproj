<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BattleshipGame</RootNamespace>
    <AssemblyName>BattleshipGame</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon />
    <StartupObject>BattleshipGame.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\img\**">
      <Link>img\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Remove="bg\**" />
    <EmbeddedResource Remove="bg\**" />
    <None Remove="bg\**" />
  </ItemGroup>

</Project>
